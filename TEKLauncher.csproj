<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <Version>9.6.96</Version>
    <ApplicationManifest>TEKLauncher.manifest</ApplicationManifest>
    <ApplicationIcon>res\Icon.ico</ApplicationIcon>
    <Authors>Nuclearist</Authors>
    <Product>TEK Launcher</Product>
    <Copyright>Copyright © 2020-2026 Nuclearist</Copyright>
    <AppendTargetFrameworkToOutputPath>False</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>False</AppendRuntimeIdentifierToOutputPath>
    <Nullable>Enable</Nullable>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>True</Optimize>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>SigningKey.snk</AssemblyOriginatorKeyFile>
    <DelaySign>False</DelaySign>
    <PublishSingleFile>True</PublishSingleFile>
    <SelfContained>False</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="res\**" />
  </ItemGroup>
</Project>